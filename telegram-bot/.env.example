# ==============================================================================
# WuWa Betting Telegram Bot — Environment Configuration
# ==============================================================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Supabase Credentials
SUPABASE_URL=https://your-project-id.supabase.co
# Use Service Role Key for full worker access, or anon key if using RPCs
SUPABASE_KEY=YOUR_SUPABASE_ANON_OR_SERVICE_ROLE_KEY

# 3. Website Public URL
SITE_URL=https://wuwa-betting.netlify.app

# 4. Polling Interval in Milliseconds (5000ms = 5s)
POLL_INTERVAL_MS=5000
